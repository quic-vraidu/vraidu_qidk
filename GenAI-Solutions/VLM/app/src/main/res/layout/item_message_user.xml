<!-- User message bubble: right-aligned, optional image thumbnail above text -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="end">

    <!-- Optional image thumbnail (GONE when no image) — rounded card like GenieX -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUserImage"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="end"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/ivUserImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <!-- Text bubble -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/user_bubble"
        android:layout_gravity="end">

        <TextView
            android:id="@+id/tvUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:maxWidth="260dp"
            android:textSize="15sp"
            android:textColor="@color/colorOnSurface"
            android:textIsSelectable="true" />

    </androidx.cardview.widget.CardView>

</LinearLayout>
